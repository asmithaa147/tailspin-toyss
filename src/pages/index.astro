---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-2xl border border-slate-700 bg-slate-900/50 p-5 shadow-lg">
      <form data-testid="game-filters-form" class="space-y-5" aria-label="Filter games">
        <div class="grid gap-6 md:grid-cols-[1.4fr_0.8fr_auto] md:items-end">
          <fieldset class="space-y-3">
            <legend class="text-sm font-medium text-slate-200">Filter by category</legend>
            <div class="flex flex-wrap gap-2">
              {categories.map((category) => (
                <label class="flex items-center gap-2 rounded-full border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500 hover:text-slate-100 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none">
                  <input
                    type="checkbox"
                    name="category"
                    value={String(category.id)}
                    data-testid="category-filter-option"
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-blue-500"
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="space-y-2">
            <label for="publisher-filter" class="text-sm font-medium text-slate-200">Publisher</label>
            <select
              id="publisher-filter"
              name="publisher"
              data-testid="publisher-filter"
              class="block w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={String(publisher.id)}>{publisher.name}</option>
              ))}
            </select>
          </div>

          <div class="flex items-center gap-3">
            <button
              type="submit"
              data-testid="apply-filters-button"
              class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white shadow-md transition hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              Apply filters
            </button>
            <a href="/" data-testid="clear-filters-link" class="text-sm text-blue-400 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500 rounded-md px-2 py-1">
              Clear filters
            </a>
          </div>
        </div>
      </form>
    </div>

    <div>
      <div class="mb-6 flex items-center justify-between gap-4">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <p class="text-sm text-slate-300" data-testid="filter-summary">Showing all games</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>

      <EmptyState text="No games match the selected filters. Try another category or publisher." hidden />
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters-form"]');
  const categoryInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('[data-testid="category-filter-option"]'),
  );
  const publisherSelect = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const emptyState = document.querySelector<HTMLElement>('[data-testid="empty-state"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const filterSummary = document.querySelector<HTMLElement>('[data-testid="filter-summary"]');

  const applyFilters = () => {
    const selectedCategories = categoryInputs
      .filter((input) => input.checked)
      .map((input) => String(input.getAttribute('value')));
    const selectedPublisher = publisherSelect ? publisherSelect.value : '';

    let visibleCount = 0;
    cards.forEach((card) => {
      const categoryIds = (card.getAttribute('data-game-category-id') ?? '').split(',').filter(Boolean);
      const publisherId = card.getAttribute('data-game-publisher-id') ?? '';
      const matchesCategory =
        selectedCategories.length === 0 || selectedCategories.some((categoryId) => categoryIds.includes(categoryId));
      const matchesPublisher = selectedPublisher === '' || publisherId === selectedPublisher;
      const isVisible = matchesCategory && matchesPublisher;

      card.hidden = !isVisible;
      if (isVisible) {
        visibleCount += 1;
      }
    });

    if (filterSummary) {
      filterSummary.textContent =
        selectedCategories.length > 0 || selectedPublisher !== ''
          ? `Showing ${visibleCount} matching game${visibleCount === 1 ? '' : 's'}`
          : 'Showing all games';
    }

    if (gamesGrid) {
      gamesGrid.hidden = visibleCount === 0;
    }

    if (emptyState) {
      emptyState.hidden = visibleCount > 0;
    }
  };

  filterForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    applyFilters();
  });

  categoryInputs.forEach((input) => {
    input.addEventListener('change', applyFilters);
  });

  publisherSelect?.addEventListener('change', applyFilters);
  applyFilters();
</script>
