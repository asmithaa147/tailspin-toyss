---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());

function categoryTestId(name: string): string {
  return `category-filter-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
}
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/70 p-5 shadow-lg">
      <form data-testid="game-filters" aria-label="Filter games by category and publisher" class="space-y-5">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end">
          <fieldset class="flex-1">
            <legend class="mb-3 block text-sm font-medium text-slate-200">Filter by category</legend>
            <div class="flex flex-wrap gap-2">
              {categories.map((category) => (
                <label
                  for={`category-${category.id}`}
                  class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/60 px-3 py-2 text-sm text-slate-200 transition hover:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none"
                >
                  <input
                    id={`category-${category.id}`}
                    type="checkbox"
                    name="category"
                    value={category.id}
                    data-testid={categoryTestId(category.name)}
                    class="h-4 w-4 rounded border-slate-500 bg-slate-900 text-blue-500 focus:ring-blue-500"
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="w-full lg:max-w-xs">
            <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Filter by publisher</label>
            <select
              id="publisher-filter"
              name="publisher"
              data-testid="publisher-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-900/60 px-3 py-2.5 text-slate-100 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher.id}>{publisher.name}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="flex justify-end">
          <button
            type="button"
            data-testid="clear-filters"
            class="rounded-lg border border-slate-600 bg-slate-700 px-3 py-2 text-sm font-medium text-slate-100 transition hover:border-blue-500 hover:bg-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            Clear filters
          </button>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div
            data-testid="no-matching-games"
            hidden
            class="rounded-xl border border-slate-700 bg-slate-800/50 px-4 py-12 text-center text-slate-300"
          >
            No games match the selected filters.
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>

  <script>
    const filtersForm = document.querySelector('[data-testid="game-filters"]');
    const grid = document.querySelector('[data-testid="games-grid"]');
    const emptyState = document.querySelector('[data-testid="no-matching-games"]');
    const clearButton = document.querySelector('[data-testid="clear-filters"]');
    const cards = Array.from(document.querySelectorAll('[data-testid="game-card"]'));

    const applyFilters = () => {
      if (!filtersForm || !grid || !cards.length) {
        return;
      }

      const selectedCategories = Array.from(
        filtersForm.querySelectorAll('input[name="category"]:checked'),
      )
        .map((input) => Number(input.value))
        .filter((value) => Number.isFinite(value));
      const selectedPublisher = Number(
        filtersForm.querySelector('select[name="publisher"]')?.value ?? 0,
      );

      let visibleCount = 0;
      for (const card of cards) {
        const cardCategoryId = Number(card.dataset.gameCategoryId ?? 0);
        const cardPublisherId = Number(card.dataset.gamePublisherId ?? 0);
        const categoryMatch = selectedCategories.length === 0 || selectedCategories.includes(cardCategoryId);
        const publisherMatch = !selectedPublisher || cardPublisherId === selectedPublisher;
        const showCard = categoryMatch && publisherMatch;

        card.hidden = !showCard;
        if (showCard) {
          visibleCount += 1;
        }
      }

      const hasResults = visibleCount > 0;
      grid.hidden = !hasResults;
      if (emptyState) {
        emptyState.hidden = hasResults;
      }
    };

    if (filtersForm) {
      filtersForm.addEventListener('change', applyFilters);
    }

    if (clearButton) {
      clearButton.addEventListener('click', () => {
        filtersForm?.querySelectorAll('input[name="category"]').forEach((input) => {
          input.checked = false;
        });
        const publisherSelect = filtersForm?.querySelector('select[name="publisher"]');
        if (publisherSelect) {
          publisherSelect.value = '';
        }
        applyFilters();
      });
    }

    applyFilters();
  </script>
</Layout>
